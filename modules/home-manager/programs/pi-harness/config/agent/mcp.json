{
  "mcpServers": {
    "obsidian": {
      "type": "local",
      "command": "mcp-obsidian",
      "args": [
        "/Users/SSimeonov/Library/Mobile Documents/iCloud~md~obsidian/Documents"
      ],
      "directTools": false
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp",
      "auth": "bearer",
      "bearerTokenEnv": "GITHUB_PAT",
      "directTools": false
    },
    "theming": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "igniteui-theming",
        "igniteui-theming-mcp"
      ],
      "directTools": false
    },
    "igniteui-cli": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "igniteui-cli", "mcp"],
      "directTools": true
    },
    "figma": {
      "url": "http://127.0.0.1:3845/mcp",
      "directTools": false
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": "codebase-memory-mcp",
      "directTools": false
    },
    "nu": {
      "type": "local",
      "command": "nu",
      "args": ["--mcp"],
      "directTools": false
    },
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "directTools": false
    }
  }
}
